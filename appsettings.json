{
  "Janitor": {
    "ScanIntervalMinutes": 5,
    "DebounceSeconds": 15,
    "Caches": [
      {
        "Path": "D:\\ci-cache\\downloads",
        "MaxSize": "100GB",
        "TrimToPercent": 90,
        "Unit": "File",
        "MinAgeMinutes": 10,
        "Exclude": [ "**/*.lock" ]
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "EventLog": {
      "LogLevel": {
        "Default": "Information"
      }
    }
  }
}
