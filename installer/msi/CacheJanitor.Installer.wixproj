<Project Sdk="WixToolset.Sdk/5.0.2">

  <PropertyGroup>
    <OutputName>CacheJanitor-$(Version)-x64</OutputName>
    <Platform>x64</Platform>
    <InstallerPlatform>x64</InstallerPlatform>
    <DefineConstants>ProductVersion=$(Version)</DefineConstants>
    <IsPackable>false</IsPackable>
    <!-- WIX1149: the core ServiceConfig element (MsiServiceConfig) is needed for delayed start and the
         failure-actions flag, which util:ServiceConfig cannot set. -->
    <SuppressSpecificWarnings>1149</SuppressSpecificWarnings>
    <!-- ICE61: MajorUpgrade allows same-version upgrades, so a rebuild of one version replaces itself. -->
    <SuppressIces>ICE61</SuppressIces>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.Util.wixext" Version="5.0.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Publish="true" builds each app's single-file publish output and binds the package to it. -->
    <ProjectReference Include="..\..\src\CacheJanitor\CacheJanitor.csproj" Publish="true" />
    <ProjectReference Include="..\..\src\CacheJanitor.Tray\CacheJanitor.Tray.csproj" Publish="true" />
  </ItemGroup>

</Project>
