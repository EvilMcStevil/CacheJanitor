<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <!-- NotifyIcon and its menu come from Windows Forms. -->
    <UseWindowsForms>true</UseWindowsForms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <AssemblyName>CacheJanitorTray</AssemblyName>
    <RootNamespace>CacheJanitor.Tray</RootNamespace>
    <ApplicationIcon>..\..\assets\CacheJanitor.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- WPF0001: Application.ThemeMode (the Fluent theme) is marked experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Only TrayIcon uses Windows Forms and System.Drawing; keep their types out of the WPF code. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CacheJanitor.Core\CacheJanitor.Core.csproj" />
    <InternalsVisibleTo Include="CacheJanitor.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\..\assets\CacheJanitor.ico" Link="CacheJanitor.ico" />
  </ItemGroup>

</Project>
